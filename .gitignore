# Ignore Maven target directory
**/target/

# Ignore Maven dependency directory
**/.m2/

# Ignore Eclipse and IntelliJ IDEA files
**/.classpath
**/.project
**/.settings/
**/.idea/
**/*.iml

# Ignore Node.js modules
**/node_modules/

# Ignore npm debug log files
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Ignore logs
**/logs
**/*.log

# Ignore environment variable files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Ignore VSCode specific files and directories
**/.vscode/
**/.history/

# Ignore other common editor files
**/*.sublime*

# Ignore OS generated files
**/.DS_Store
**/Thumbs.db

# Ignore Mac system files
**/*.swp
**/*.swo
**/._*
**/.Spotlight-V100
**/.Trashes